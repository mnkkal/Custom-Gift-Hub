{
  "name": "custom-gift-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Vendure backend for Custom Gift Hub",
  "scripts": {
    "start:dev": "tsx watch src/index.ts",
    "build:backend": "tsc",
    "build:storefront": "cd storefront && npm install && npm run build",
    "build": "npm run build:backend && npm run build:storefront",
    "start": "node start-unified.js",
    "start:backend-only": "node dist/index.js"
  },

  "dependencies": {
    "@vendure/core": "^3.7.0",
    "@vendure/admin-ui-plugin": "^3.7.0",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}